# ============================================================
# Grainily — Variables d'environnement (Hostinger VPS)
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs.
# Ne committez JAMAIS le fichier .env dans Git.

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://localmarket_user:MOT_DE_PASSE_FORT@localhost:5432/localmarket_db

# --- Serveur API (port interne, Nginx fait le proxy) ---
PORT=8080

# --- Frontend (chemin de base, laisser / pour la racine) ---
BASE_PATH=/

# --- Environnement ---
NODE_ENV=production

# --- Sécurité admin ---
# Changez ce token root immédiatement après le déploiement !
# ADMIN_ROOT_TOKEN=localmarket-root-token-2026   # défini dans adminAuth.ts

# --- Sécurité JWT (obligatoire en production) ---
# Générez une valeur aléatoire forte, ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGEZ_MOI_VALEUR_ALEATOIRE_FORTE

# --- Stripe ---
# Utilisez une clé sk_test_... en test, sk_live_... en production.
STRIPE_SECRET_KEY=sk_live_...
# Requis pour vérifier les webhooks Stripe (voir section 5 du GUIDE.md)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Resend) ---
RESEND_API_KEY=re_...
# Doit être une adresse sur un domaine vérifié dans Resend (https://resend.com/domains).
# Tant que grainily.com n'est pas vérifié, utilisez un domaine déjà vérifié sur votre compte Resend.
RESEND_FROM_EMAIL=noreply@grainily.com

# --- URL publique du site (utilisée dans les emails) ---
SITE_URL=https://VOTRE_DOMAINE.fr
