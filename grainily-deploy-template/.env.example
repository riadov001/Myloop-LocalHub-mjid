# ============================================================
# Grainily — Variables d'environnement (Hostinger)
# Copiez ce fichier en .env et remplissez chaque valeur.
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
NODE_ENV=production

# Port d'écoute — sur Hostinger Node.js App, laissez 3000
# (Hostinger le remappe automatiquement sur le port 80/443)
PORT=3000

# ── Base de données Supabase ──────────────────────────────────
# Utilisez l'URL du pooler Session-mode (port 5432, IPv4)
# Project Settings → Database → Connection string → URI → Session
DATABASE_URL=postgresql://postgres.VOTRE_REF:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Authentification ──────────────────────────────────────────
# Clé secrète JWT — générez une chaîne aléatoire de 64+ caractères
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Secret de session Express
SESSION_SECRET=changez-moi-aussi

# ── Compte Root (administrateur principal) ────────────────────
ROOT_ADMIN_EMAIL=votre@email.com
ROOT_ADMIN_PASSWORD=MotDePasseRootTresSecurise!

# ── Paiements Stripe (optionnel) ──────────────────────────────
STRIPE_SECRET_KEY=sk_live_...

# ── Emails Resend (optionnel) ─────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@votredomaine.com
